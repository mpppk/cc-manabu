{
  "name": "cc-manabu",
  "version": "0.7.0",
  "description": "Local chat app that talks to Claude through your Claude Code login",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "cc-manabu": "./src/binary.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "bun test",
    "record:fixtures": "bun scripts/record-sdk-messages.ts",
    "test:live": "CC_MANABU_LIVE=1 bun test test/live",
    "test:e2e": "playwright test",
    "build:binary": "bun run build-binary.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "1.63.0",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@ai-sdk/provider": "^4",
    "@ai-sdk/provider-utils": "^5.0.83",
    "@ai-sdk/react": "^4.0.184",
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@orpc/client": "^1.16.5",
    "@orpc/server": "^1.16.5",
    "@praha/byethrow": "^0.13.0",
    "@praha/error-factory": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@streamdown/cjk": "^1.0.5",
    "@streamdown/code": "^2.0.1",
    "@streamdown/math": "^1.0.4",
    "@streamdown/mermaid": "^1.0.4",
    "ai": "^7",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "katex": "^0.16.27",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-breaks": "^4.0.0",
    "streamdown": "^2.8.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  }
}
