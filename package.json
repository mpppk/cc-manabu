{
  "name": "cc-manabu",
  "version": "0.0.0",
  "description": "Local chat app that talks to Claude through your Claude Code login",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "cc-manabu": "./src/binary.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "bun test",
    "record:fixtures": "bun scripts/record-sdk-messages.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@ai-sdk/provider": "^4",
    "@ai-sdk/provider-utils": "^5.0.83",
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@orpc/client": "^1.16.5",
    "@orpc/server": "^1.16.5",
    "@praha/byethrow": "^0.13.0",
    "@praha/error-factory": "^1.4.1",
    "ai": "^7",
    "zod": "^4.6.7"
  }
}
